#!/usr/bin/env python3
"""Executable entry point for the sabi-extractor CLI.

Run without installing the package:

    ./bin/sabi-extractor --username "$SABI_USERNAME" --password "$SABI_PASSWORD" \
        --search "madrid software"

Also referenced by CI/release workflows for direct invocation.
"""

from __future__ import annotations

import os
import sys

# Make the project root importable so `src` resolves whether the script is run
# from the checkout or installed elsewhere.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from src.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
