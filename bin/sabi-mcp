#!/usr/bin/env python3
"""Executable entry point for the sabi-mcp MCP server.

Run without installing the package:

    ./bin/sabi-mcp --transport stdio
    ./bin/sabi-mcp --transport streamable-http --port 8000

Requires SABI_USERNAME and SABI_PASSWORD environment variables for
authentication to SABI Informa.
"""

from __future__ import annotations

import os
import sys

# Make the project root importable so `src` resolves whether the script is run
# from the checkout or installed elsewhere.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from src.mcp_server import main

if __name__ == "__main__":
    raise SystemExit(main())
